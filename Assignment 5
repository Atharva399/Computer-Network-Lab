Client
import socket
client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
client.connect(("127.0.0.1", 5000))
msg = input("Client: ")
client.send(msg.encode())
reply = client.recv(1024).decode()
print("Server:", reply)
client.close()


Server
import socket
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind(("127.0.0.1", 5000))
server.listen(1)
print("Waiting for client...")
conn, addr = server.accept()
print("Client connected")
msg = conn.recv(1024).decode().lower()
print("Client:", msg)
# Predefined responses
if msg == "hello":
    reply = "Hello! How are you?"
elif msg == "how are you":
    reply = "I am fine! Thanks for asking."
elif msg == "what is your name":
    reply = "I am a simple TCP message bot."
elif msg == "good morning":
    reply = "Good morning! Have a nice day."
elif msg == "bye":
    reply = "Goodbye! Have a nice day."
else:
    reply = "Sorry, I don't understand that message."
print("Server:", reply)
conn.send(reply.encode())
conn.close()
server.close()



