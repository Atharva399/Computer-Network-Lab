#include <iostream>
#include <vector>
#include <iomanip>
#include <limits>

using namespace std;

const int INF = 9999;

int main() {
    int N;

    cout << "Enter number of routers: ";
    cin >> N;

    vector<vector<int>> cost(N, vector<int>(N));
    vector<vector<int>> distance(N, vector<int>(N));
    vector<vector<int>> nextHop(N, vector<int>(N, -1));

    // Input Cost Matrix
    cout << "\nEnter the network cost matrix:\n";
    cout << "Use " << INF << " if two routers are not directly connected.\n";

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> cost[i][j];

            distance[i][j] = cost[i][j];

            if (i == j) {
                distance[i][j] = 0;
                nextHop[i][j] = i;
            }
            else if (cost[i][j] != INF) {
                nextHop[i][j] = j;
            }
            else {
                nextHop[i][j] = -1;
            }
        }
    }

    // Display Initial Cost Matrix
    cout << "\nInitial Cost Matrix:\n";

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            if (cost[i][j] == INF)
                cout << setw(6) << "INF";
            else
                cout << setw(6) << cost[i][j];
        }
        cout << endl;
    }

    // Display Initial Routing Tables
    cout << "\nInitial Routing Tables:\n";

    for (int source = 0; source < N; source++) {
        cout << "\nRouting Table for Router " << source << ":\n";
        cout << "Destination\tCost\tNext Hop\n";

        for (int destination = 0; destination < N; destination++) {
            cout << destination << "\t\t";

            if (distance[source][destination] == INF)
                cout << "INF\t";
            else
                cout << distance[source][destination] << "\t";

            if (nextHop[source][destination] == -1)
                cout << "-\n";
            else
                cout << nextHop[source][destination] << "\n";
        }
    }

    // Distance Vector Updates
    bool updated;

    do {
        updated = false;

        for (int source = 0; source < N; source++) {
            for (int destination = 0; destination < N; destination++) {
                for (int neighbour = 0; neighbour < N; neighbour++) {

                    if (cost[source][neighbour] != INF &&
                        distance[neighbour][destination] != INF) {

                        int newCost =
                            cost[source][neighbour] +
                            distance[neighbour][destination];

                        if (newCost < distance[source][destination]) {
                            distance[source][destination] = newCost;
                            nextHop[source][destination] = neighbour;
                            updated = true;
                        }
                    }
                }
            }
        }

    } while (updated);

    // Display Final Routing Tables
    cout << "\n\nFinal Routing Tables:\n";

    for (int source = 0; source < N; source++) {
        cout << "\nRouting Table for Router " << source << ":\n";
        cout << "Destination\tCost\tNext Hop\n";

        for (int destination = 0; destination < N; destination++) {
            cout << destination << "\t\t";

            if (distance[source][destination] == INF)
                cout << "INF\t";
            else
                cout << distance[source][destination] << "\t";

            if (nextHop[source][destination] == -1)
                cout << "-\n";
            else
                cout << nextHop[source][destination] << "\n";
        }
    }

    // Select Source and Destination
    int selectedSource, selectedDestination;

    cout << "\nEnter source router: ";
    cin >> selectedSource;

    cout << "\nEnter destination router: ";
    cin >> selectedDestination;

    // Check for valid router numbers
    if (selectedSource < 0 || selectedSource >= N ||
        selectedDestination < 0 || selectedDestination >= N) {

        cout << "Invalid router number.\n";
        return 0;
    }

    // Display Shortest Path and Minimum Cost
    if (distance[selectedSource][selectedDestination] == INF) {

        cout << "No path exists between the selected routers.\n";

    }
    else {

        cout << "\nMinimum Cost: "
             << distance[selectedSource][selectedDestination] << endl;

        cout << "Shortest Path: ";

        int current = selectedSource;

        cout << current;

        while (current != selectedDestination) {

            current = nextHop[current][selectedDestination];

            if (current == -1) {
                cout << "\nPath cannot be determined.\n";
                return 0;
            }

            cout << " -> " << current;
        }
    }

    return 0;
}
